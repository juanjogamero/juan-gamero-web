---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Header from '../components/Header.astro';
import Features from '../components/Features.astro';
import AboutWork from '../components/AboutWork.astro';
import Portfolio from '../components/Portfolio.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'Carpintería Metálica Juan Gamero',
  description: 'Trabajos de hierro y carpintería metálica a medida en Casariche y pueblos cercanos.',
  areaServed: ['Casariche', 'Herrera', 'Estepa', 'Pedrera', 'Puente Genil', 'La Roda de Andalucía', 'Osuna'],
  telephone: '+34 675 731 867',
  sameAs: ['https://www.instagram.com/carpinteriametalica.juangamero/'],
  url: 'https://metalicasgamero.es/'
};
---
<BaseLayout
  title="Carpintería metálica en Casariche y alrededores | Juan Gamero"
  description="Carpintería metálica en Casariche: puertas de hierro, rejas, forja, tejados de chapa, barandas y estructuras. Trabajos a medida en Herrera, Estepa y pueblos cercanos."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Header />
  <main>
    <Hero />
    <div class="work-screen" id="conocer-el-taller">
      <Features />
      <AboutWork />
    </div>
    <Portfolio />
  </main>
</BaseLayout>
