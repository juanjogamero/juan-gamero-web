---
const phone = '+34675731867';
const instagram = 'https://www.instagram.com/carpinteriametalica.juangamero/';
---

<header class="global-header" id="global-header">
  <div class="header-inner">
    <a class="header-logo" href="#inicio" aria-label="Juan Gamero, volver al inicio">
      <strong>Juan Gamero</strong>
      <span>CARPINTERÍA METÁLICA</span>
    </a>

    <nav class="header-nav" aria-label="Navegación principal">
      <a href="#inicio"><span class="nav-label">Inicio</span></a>
      <a href="#servicios"><span class="nav-label">Servicios</span></a>
      <a href={instagram} target="_blank" rel="noopener noreferrer"><span class="nav-label">Trabajos</span><span class="external-mark" aria-hidden="true">↗</span></a>
      <button type="button" data-open-modal="areas"><span class="nav-label">Zona de trabajo</span></button>
    </nav>

    <div class="header-actions">
      <a class="header-contact" href={"tel:" + phone}><span class="contact-label">Pedir presupuesto</span><span class="contact-icon" aria-hidden="true">↗</span></a>
      <button class="header-menu-button" id="header-menu-button" type="button" aria-expanded="false" aria-controls="header-mobile-nav" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="header-mobile-nav" id="header-mobile-nav" aria-label="Navegación móvil" hidden>
    <a href="#inicio">Inicio</a>
    <a href="#servicios">Servicios</a>
    <a href={instagram} target="_blank" rel="noopener noreferrer">Ver trabajos ↗</a>
    <button type="button" data-open-modal="areas">Zona de trabajo</button>
    <a href={"tel:" + phone}>Contacto y presupuesto</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('#global-header');
  const menuButton = document.querySelector<HTMLButtonElement>('#header-menu-button');
  const mobileNav = document.querySelector<HTMLElement>('#header-mobile-nav');

  function closeHeaderMenu() {
    if (mobileNav) mobileNav.hidden = true;
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Abrir menú');
  }

  if (header) {
    const updateHeader = () => {
      const scrolled = window.scrollY > 44;
      header.classList.toggle('is-scrolled', scrolled);
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    menuButton?.addEventListener('click', () => {
      const expanded = menuButton.getAttribute('aria-expanded') === 'true';
      if (mobileNav) mobileNav.hidden = expanded;
      menuButton.setAttribute('aria-expanded', String(!expanded));
      menuButton.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú');
    });
    mobileNav?.querySelectorAll('a, button').forEach(el => el.addEventListener('click', closeHeaderMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeHeaderMenu(); });
    document.addEventListener('click', e => {
      if (header && !header.contains(e.target as Node)) closeHeaderMenu();
    });
  }
</script>

<style>
  /* Cabecera sencilla, sin cápsula ni efectos de cristal.
     Al desplazarse se convierte en una barra blanca fija. */
  .global-header {
    --header-side: clamp(22px,5.75vw,95px);
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    height: 82px;
    color: #fff;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color .32s ease, border-color .32s ease,
                color .32s ease, box-shadow .32s ease;
  }
  .global-header.is-scrolled {
    color: #252924;
    background: #fdfdfb;
    border-bottom-color: #e4e6e1;
    box-shadow: 0 4px 18px rgba(13, 21, 15, .075);
    animation: header-slide .38s cubic-bezier(.2,.8,.2,1) both;
  }
  @keyframes header-slide {
    from { transform: translateY(-12px); }
    to { transform: translateY(0); }
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(18px,2vw,30px);
    width: 100%;
    max-width: 1800px;
    height: 100%;
    padding-inline: var(--header-side);
    margin-inline: auto;
  }
  .header-logo {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    text-shadow: 0 1px 12px rgba(0,0,0,.17);
  }
  .is-scrolled .header-logo { text-shadow: none; }
  .header-logo strong {
    font-size: clamp(19px,1.85vw,25px);
    line-height: 1;
    letter-spacing: -.052em;
    font-weight: 730;
  }
  .header-logo span {
    font-size: 9px;
    line-height: 1;
    font-weight: 650;
    letter-spacing: .145em;
    opacity: .88;
  }
  .header-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px,2.2vw,34px);
    margin-left: auto;
  }
  .header-nav a,
  .header-nav button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: 0;
    border-radius: 0;
    padding: 12px 0;
    margin: 0;
    color: inherit;
    font: inherit;
    font-size: clamp(12px,1vw,13px);
    font-weight: 660;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    text-shadow: 0 1px 10px rgba(0,0,0,.14);
    cursor: pointer;
    transition: opacity .2s ease;
  }
  .is-scrolled .header-nav a,
  .is-scrolled .header-nav button { text-shadow: none; }
  .header-nav a::after,
  .header-nav button::after {
    position: absolute;
    content: '';
    height: 2px;
    bottom: 5px;
    left: 0;
    right: 0;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .25s cubic-bezier(.2,.65,.2,1);
  }
  .header-nav a:hover::after,
  .header-nav button:hover::after,
  .header-nav a:focus-visible::after,
  .header-nav button:focus-visible::after {
    transform: scaleX(1);
  }
  .header-nav a:hover,
  .header-nav button:hover { opacity: .82; }
  .external-mark { font-size: 11px; font-weight: 400; opacity: .8; }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-contact {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 19px;
    min-height: 43px;
    padding: 0 15px 0 18px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: #fff;
    color: #1e2520;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .header-contact span { font-size: 18px; line-height: 1; font-weight: 400; }
  .header-contact:hover { background: #e9eee9; }
  .is-scrolled .header-contact {
    color: #fff;
    background: #27362e;
  }
  .is-scrolled .header-contact:hover { background: #405247; }
  .header-menu-button { display: none; }
  .header-mobile-nav[hidden] { display: none !important; }

  @media(max-width:1050px) {
    .header-nav { gap: 16px; }
    .header-nav a, .header-nav button { font-size: 12px; }
    .header-contact { gap: 11px; padding-inline: 13px; }
  }
  @media(max-width:900px) {
    .global-header { --header-side: clamp(18px,5vw,36px); height: 70px; }
    .global-header.is-scrolled { height: 70px; }
    .header-logo strong { font-size: 21px; }
    .header-logo span { font-size: 8px; }
    .header-nav { display: none; }
    .header-contact { min-height: 39px; font-size: 11px; gap: 8px; }
    .header-menu-button {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 41px;
      height: 41px;
      color: inherit;
      border: 1px solid rgba(255,255,255,.75);
      border-radius: 5px;
      background: transparent;
      cursor: pointer;
      transition: background-color .2s ease;
    }
    .is-scrolled .header-menu-button { border-color: #b3bcb5; }
    .header-menu-button:hover { background: rgba(255,255,255,.13); }
    .is-scrolled .header-menu-button:hover { background: #f1f3f0; }
    .header-menu-button span {
      width: 19px;
      height: 2px;
      border-radius: 1px;
      background: currentColor;
    }
    .header-mobile-nav:not([hidden]) {
      display: grid;
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      gap: 0;
      padding: 12px var(--header-side);
      background: #fcfdfb;
      color: #242b25;
      border-bottom: 1px solid #e4e6e1;
      box-shadow: 0 12px 25px rgba(0,0,0,.1);
    }
    .header-mobile-nav a, .header-mobile-nav button {
      display: block;
      width: 100%;
      padding: 14px 5px;
      border: 0;
      border-bottom: 1px solid #e8eae6;
      border-radius: 0;
      color: inherit;
      background: transparent;
      font: inherit;
      font-size: 14px;
      font-weight: 650;
      text-align: left;
      text-decoration: none;
      cursor: pointer;
      transition: color .2s ease, padding-left .2s ease;
    }
    .header-mobile-nav a:hover,
    .header-mobile-nav button:hover {
      color: #617e64;
      padding-left: 13px;
    }
    .header-mobile-nav a:last-child { border-bottom: 0; }
  }
  @media(max-width:420px) {
    .header-logo strong { font-size: 19px; }
    .header-logo span { font-size: 7.5px; }
    .header-contact {
      min-height: 40px;
      padding: 0 10px;
      font-size: 0;
    }
    .header-contact span { font-size: 19px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .global-header,
    .header-contact,
    .header-nav a,
    .header-nav button,
    .header-nav a::after,
    .header-nav button::after,
    .header-mobile-nav a,
    .header-mobile-nav button { transition: none !important; animation: none !important; }
  }

  /* Hover refinado: el texto se eleva y la flecha describe un giro. */
  .header-nav .nav-label {
    display:inline-block;
    transition:transform .36s cubic-bezier(.2,.8,.2,1),letter-spacing .36s ease;
  }
  .header-nav a:is(:hover,:focus-visible) .nav-label,
  .header-nav button:is(:hover,:focus-visible) .nav-label {
    transform:translateY(-3px);
    letter-spacing:.012em;
  }
  .header-nav a::after,.header-nav button::after {
    height:2px;
    bottom:4px;
    transform:translateY(3px) scaleX(0);
    transform-origin:left center;
    transition:transform .38s cubic-bezier(.2,.8,.2,1);
  }
  .header-nav a:is(:hover,:focus-visible)::after,
  .header-nav button:is(:hover,:focus-visible)::after {
    transform:translateY(0) scaleX(1);
  }
  .header-nav .external-mark {
    display:inline-block;
    transition:transform .42s cubic-bezier(.2,.8,.2,1);
  }
  .header-nav a:is(:hover,:focus-visible) .external-mark {
    transform:translate(2px,-1px) rotate(45deg);
  }
  .header-contact {
    border-radius:999px;
    gap:11px;
    overflow:hidden;
    transition:background-color .3s,transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .3s;
  }
  .header-contact .contact-label {
    display:inline-block;
    transition:transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .header-contact .contact-icon {
    display:inline-grid;
    width:26px;height:26px;
    place-items:center;
    border-radius:50%;
    background:rgba(30,40,33,.08);
    transition:transform .45s cubic-bezier(.2,.85,.2,1),background-color .25s;
  }
  .is-scrolled .header-contact .contact-icon{background:rgba(255,255,255,.14)}
  .header-contact:is(:hover,:focus-visible){transform:translateY(-2px);box-shadow:0 9px 22px rgba(0,0,0,.14)}
  .header-contact:is(:hover,:focus-visible) .contact-label{transform:translateX(3px)}
  .header-contact:is(:hover,:focus-visible) .contact-icon{transform:rotate(45deg) translate(2px,-1px);background:rgba(30,40,33,.17)}
  .is-scrolled .header-contact:is(:hover,:focus-visible) .contact-icon{background:rgba(255,255,255,.26)}
  .header-menu-button{border-radius:50%;transition:transform .28s ease,background-color .28s ease}
  .header-menu-button:hover{transform:scale(1.05)}
  .header-menu-button span{transition:transform .28s ease}
  .header-menu-button:hover span:first-child{transform:translateX(-3px)}
  .header-menu-button:hover span:last-child{transform:translateX(3px)}
  @media(max-width:420px){
    .header-contact .contact-label{display:none}
    .header-contact .contact-icon{width:25px;height:25px}
  }
  @media(prefers-reduced-motion:reduce){
    .header-nav .nav-label,.header-nav .external-mark,
    .header-contact,.header-contact .contact-label,.header-contact .contact-icon,
    .header-menu-button,.header-menu-button span {transition:none!important}
    .header-nav a:is(:hover,:focus-visible) .nav-label,
    .header-nav button:is(:hover,:focus-visible) .nav-label,
    .header-nav a:is(:hover,:focus-visible) .external-mark,
    .header-contact:is(:hover,:focus-visible),
    .header-contact:is(:hover,:focus-visible) .contact-label,
    .header-contact:is(:hover,:focus-visible) .contact-icon,
    .header-menu-button:hover,.header-menu-button:hover span{transform:none!important}
  }
</style>