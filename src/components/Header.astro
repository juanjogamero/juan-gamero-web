---
const phone = '+34675731867';
const instagram = 'https://www.instagram.com/carpinteriametalica.juangamero/';
---

<header class="global-header" id="global-header">
  <div class="header-inner">
    <a class="header-logo" href="#inicio" aria-label="Juan Gamero, volver al inicio">
      <strong>Juan Gamero</strong>
      <span>CARPINTERÍA METÁLICA</span>
    </a>

    <nav class="header-nav" aria-label="Navegación principal">
      <a href="#inicio">Inicio</a>
      <a href="#servicios">Servicios</a>
      <a href={instagram} target="_blank" rel="noopener noreferrer">Trabajos <span class="external-mark" aria-hidden="true">↗</span></a>
      <button type="button" data-open-modal="areas">Zona de trabajo</button>
    </nav>

    <div class="header-actions">
      <a class="header-contact" href={"tel:" + phone}>Pedir presupuesto <span aria-hidden="true">↗</span></a>
      <button class="header-menu-button" id="header-menu-button" type="button" aria-expanded="false" aria-controls="header-mobile-nav" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="header-mobile-nav" id="header-mobile-nav" aria-label="Navegación móvil" hidden>
    <a href="#inicio">Inicio</a>
    <a href="#servicios">Servicios</a>
    <a href={instagram} target="_blank" rel="noopener noreferrer">Ver trabajos ↗</a>
    <button type="button" data-open-modal="areas">Zona de trabajo</button>
    <a href={"tel:" + phone}>Contacto y presupuesto</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('#global-header');
  const menuButton = document.querySelector<HTMLButtonElement>('#header-menu-button');
  const mobileNav = document.querySelector<HTMLElement>('#header-mobile-nav');

  function closeHeaderMenu() {
    if (mobileNav) mobileNav.hidden = true;
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Abrir menú');
  }

  if (header) {
    const updateHeader = () => {
      const scrolled = window.scrollY > 44;
      header.classList.toggle('is-scrolled', scrolled);
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    menuButton?.addEventListener('click', () => {
      const expanded = menuButton.getAttribute('aria-expanded') === 'true';
      if (mobileNav) mobileNav.hidden = expanded;
      menuButton.setAttribute('aria-expanded', String(!expanded));
      menuButton.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú');
    });
    mobileNav?.querySelectorAll('a, button').forEach(el => el.addEventListener('click', closeHeaderMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeHeaderMenu(); });
    document.addEventListener('click', e => {
      if (header && !header.contains(e.target as Node)) closeHeaderMenu();
    });
  }
</script>

<style>
  .global-header {
    --header-side: clamp(20px,5.75vw,95px);
    position:fixed;z-index:100;
    top:16px;left:var(--header-side);right:var(--header-side);
    height:66px;
    display:flex;align-items:center;
    border:1px solid rgba(255,255,255,.24);
    background:rgba(16,21,19,.68);
    color:#fff;
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
    border-radius:15px;
    box-shadow:0 6px 22px rgba(0,0,0,.13);
    transition:top .38s ease,left .38s ease,right .38s ease,background .38s ease,color .38s ease,border-radius .38s ease,box-shadow .38s ease;
  }
  .global-header.is-scrolled {
    top:0;left:0;right:0;
    height:70px;
    color:#19231e;background:rgba(250,250,248,.96);
    border-color:rgba(22,35,28,.08);
    border-radius:0;
    box-shadow:0 8px 28px rgba(18,30,24,.12);
    animation:header-appear .45s cubic-bezier(.2,.75,.2,1) both;
  }
  @keyframes header-appear {
    from { transform:translateY(-26px); opacity:.55; }
    to { transform:translateY(0); opacity:1; }
  }
  .header-inner {
    display:flex;align-items:center;justify-content:space-between;
    width:100%;gap:clamp(14px,2vw,28px);
    padding:0 clamp(17px,2.2vw,28px);
  }
  .is-scrolled .header-inner{padding:0 var(--header-side)}
  .header-logo{display:flex;flex-direction:column;gap:4px;flex:none;text-decoration:none;color:inherit;white-space:nowrap}
  .header-logo strong{font-weight:750;font-size:clamp(19px,1.8vw,24px);letter-spacing:-.06em;line-height:1}
  .header-logo span{font-size:9px;letter-spacing:.15em;font-weight:650;opacity:.76}
  .header-nav{display:flex;gap:clamp(13px,2vw,29px);align-items:center;justify-content:center;margin-left:auto}
  .header-nav a,.header-nav button{
    border:0;background:none;color:inherit;text-decoration:none;padding:11px 0;
    font:inherit;font-size:clamp(11px,1vw,13px);font-weight:650;white-space:nowrap;cursor:pointer;
    transition:opacity .2s;
  }
  .header-nav a:hover,.header-nav button:hover{opacity:.65}
  .external-mark{font-size:12px;opacity:.8}
  .header-actions{display:flex;align-items:center;gap:10px}
  .header-contact{
    background:#f7f8f5;color:#1d251e;
    padding:12px 14px 12px 17px;display:inline-flex;align-items:center;gap:18px;
    border-radius:9px;font-size:12px;line-height:1;font-weight:750;text-decoration:none;white-space:nowrap;
    transition:background .2s,transform .2s;
  }
  .header-contact span{font-size:18px;font-weight:450}
  .header-contact:hover{background:white;transform:translateY(-1px)}
  .is-scrolled .header-contact{background:#1e2b24;color:white}
  .is-scrolled .header-contact:hover{background:#344237}
  .header-menu-button{display:none}
  .header-mobile-nav[hidden]{display:none!important}
  @media(max-width:1050px){
    .header-nav{gap:12px}
    .header-nav a,.header-nav button{font-size:11px}
    .header-contact{gap:8px}
  }
  @media(max-width:900px){
    .global-header{--header-side:clamp(16px,5vw,36px);top:12px;height:61px;border-radius:13px}
    .global-header.is-scrolled{height:65px}
    .header-inner{padding-inline:15px}
    .header-logo strong{font-size:19px}
    .header-logo span{font-size:8px}
    .header-nav{display:none}
    .header-contact{padding:11px 12px;font-size:11px;gap:8px}
    .header-menu-button{
      display:flex;flex-direction:column;align-items:center;justify-content:center;
      gap:4px;height:40px;width:42px;
      border:1px solid currentColor;border-radius:9px;background:transparent;color:inherit;cursor:pointer;
    }
    .header-menu-button span{width:18px;height:2px;background:currentColor;border-radius:4px}
    .header-mobile-nav:not([hidden]) {
      display:grid;position:absolute;top:calc(100% + 8px);right:0;left:0;
      gap:2px;padding:10px;background:#f7f8f6;color:#1d2720;
      border:1px solid #dce1dc;border-radius:12px;
      box-shadow:0 18px 40px #0004;
    }
    .header-mobile-nav a,.header-mobile-nav button{
      padding:13px;text-align:left;border:0;background:none;color:inherit;
      font:inherit;font-size:14px;font-weight:650;text-decoration:none;border-radius:8px;cursor:pointer;
    }
    .header-mobile-nav a:hover,.header-mobile-nav button:hover{background:#e9ece8}
  }
  @media(max-width:400px){
    .header-contact{font-size:0;padding:8px 11px;min-height:40px}
    .header-contact span{font-size:20px}
    .header-logo strong{font-size:18px}
  }
  @media(prefers-reduced-motion:reduce){
    .global-header,.header-contact,.header-nav a,.header-nav button{transition:none;animation:none}
  }
</style>