---
const phone = '+34675731867';
const instagram = 'https://www.instagram.com/carpinteriametalica.juangamero/';
const services = [
  { title: 'Rejas y forja', text: 'Rejas de hierro, trabajos de forja y soluciones a medida para viviendas.' },
  { title: 'Puertas metálicas', text: 'Puertas para patios, cocheras, parcelas, fincas y accesos de naves.' },
  { title: 'Tejados y cubiertas', text: 'Tejados de chapa, chapa imitación teja, porches y espacios cubiertos.' },
  { title: 'Barandas y pasamanos', text: 'Barandas de hierro para balcones, escaleras y terrazas.' },
  { title: 'Estructuras y cerramientos', text: 'Estructuras metálicas, cerramientos de naves y soluciones para el campo.' },
  { title: 'Soldadura y arreglos', text: 'Reparaciones, soldaduras y trabajos especiales de hierro.' },
  { title: 'Puertas automáticas', text: 'Instalación y motorización mediante colaboración con profesionales especializados.' }
];
---

<section class="home-hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-photo" aria-hidden="true">
    <img
      src="https://images.pexels.com/photos/7587880/pexels-photo-7587880.jpeg?auto=compress&cs=tinysrgb&w=2200"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 id="hero-title">Carpintería metálica. <span>Hierro hecho para durar.</span></h1>
    <p>Rejas, puertas, barandas y cubiertas de hierro a medida.<br class="desktop-break" /> En Casariche y pueblos cercanos.</p>
    <div class="hero-actions">
      <a class="action action-primary" href={"tel:" + phone}>Pedir presupuesto <span aria-hidden="true">→</span></a>
      <a class="action action-secondary" href={instagram} target="_blank" rel="noopener noreferrer">Ver trabajos</a>
    </div>
  </div>

  <div class="hero-bottom">
    <p class="bottom-intro">De una reja para casa a una cubierta para tu nave. Trabajos de hierro, forja y soldadura adaptados a lo que necesitas.</p>
    <div class="hero-services" aria-label="Especialidades de carpintería metálica">
      <div><strong>Rejas</strong><span>Protección y diseño</span></div>
      <div><strong>Puertas</strong><span>Accesos a medida</span></div>
      <div><strong>Tejados</strong><span>Chapa y cubiertas</span></div>
    </div>
  </div>
</section>

<dialog class="hero-dialog" id="services-dialog" aria-labelledby="services-dialog-heading">
  <button type="button" class="dialog-close" data-close-dialog aria-label="Cerrar ventana">×</button>
  <p class="dialog-overline">QUÉ HACEMOS</p>
  <h2 id="services-dialog-heading">Trabajos de carpintería metálica</h2>
  <p>Juan Gamero realiza trabajos de hierro a medida para viviendas, fincas, naves y negocios. Si necesitas algo que no aparece aquí, puedes consultarlo igualmente.</p>
  <div class="dialog-services">
    {services.map(service => <article><h3>{service.title}</h3><p>{service.text}</p></article>)}
  </div>
  <a class="dialog-contact" href={"tel:" + phone}>Consultar mi trabajo <span aria-hidden="true">→</span></a>
</dialog>

<dialog class="hero-dialog" id="areas-dialog" aria-labelledby="areas-dialog-heading">
  <button type="button" class="dialog-close" data-close-dialog aria-label="Cerrar ventana">×</button>
  <p class="dialog-overline">CERCA DE TI</p>
  <h2 id="areas-dialog-heading">Carpintería metálica en Casariche y alrededores</h2>
  <p>El taller trabaja desde Casariche y atiende encargos en poblaciones próximas como Herrera, Estepa, Pedrera, La Roda de Andalucía, Puente Genil y Osuna. Consulta disponibilidad para tu localidad.</p>
  <a class="dialog-contact" href={"tel:" + phone}>Preguntar por mi localidad <span aria-hidden="true">→</span></a>
</dialog>

<script>
  // Los botones del header global también pueden abrir estos detalles.
  document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach(button => {
    button.addEventListener('click', () => {
      const id = button.dataset.openModal === 'areas' ? 'areas-dialog' : 'services-dialog';
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      if (dialog && !dialog.open) dialog.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.hero-dialog').forEach(dialog => {
    dialog.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  /* Composición de la referencia: 1200 × 674.
     Posiciones en porcentajes para conservar la escala a pantalla completa. */
  .home-hero {
    --inset: clamp(32px, 5.75vw, 95px);
    position: relative;
    isolation: isolate;
    height: 100vh;
    height: 100svh;
    width: 100%;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    color: #fff;
    background: #1b2521;
  }
  .hero-photo, .hero-shade, .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-photo { z-index: -2; overflow: hidden; }
  .hero-photo img {
    object-fit: cover;
    object-position: center center;
    filter: saturate(.86) contrast(.96);
  }
  .hero-shade {
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(9,17,15,.12) 0%,rgba(10,13,13,.12) 27%,rgba(10,13,12,.31) 63%,rgba(9,11,11,.72) 100%),
      linear-gradient(90deg,rgba(9,13,12,.35) 0%,rgba(9,13,12,.20) 47%,rgba(9,13,12,.04) 100%);
  }

  /* Cabecera: palabra izquierda, enlaces discretos a la derecha. */
  .site-header {
    position: absolute;
    top: clamp(25px,5.3vh,44px);
    left: var(--inset);
    right: var(--inset);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 0;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    flex-shrink: 0;
    font-size: clamp(20px,2vw,25px);
    font-weight: 520;
    line-height: 1;
    letter-spacing: -.055em;
    white-space: nowrap;
  }
  .wordmark-dot { color: #f5f6f4; }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(20px,2.55vw,36px);
  }
  .desktop-nav a,.desktop-nav button {
    font: inherit;
    padding: 4px 0;
    margin: 0;
    background: none;
    border: 0;
    color: #f5f6f4;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 540;
    letter-spacing: .018em;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity .2s ease;
  }
  .desktop-nav a:hover,.desktop-nav button:hover { opacity: .68; }
  .mobile-menu-trigger,.mobile-navigation[hidden] { display: none; }

  /* Titular y botones: misma huella visual que el mockup. */
  .hero-content {
    position: absolute;
    top: 25.3%;
    left: var(--inset);
    right: var(--inset);
    z-index: 1;
    max-width: 980px;
    padding: 0;
    margin: 0;
  }
  h1 {
    display: block;
    max-width: 970px;
    padding: 0;
    margin: 0;
    font-size: clamp(45px, 5.25vw, 72px);
    line-height: 1.075;
    letter-spacing: -.059em;
    font-weight: 640;
    text-wrap: balance;
    text-shadow: 0 1px 20px rgba(0,0,0,.12);
  }
  h1 span { display: block; }
  .hero-content p {
    max-width: 600px;
    margin: 18px 0 0;
    color: #f6f6f3;
    font-size: clamp(14px,1.25vw,17px);
    line-height: 1.42;
    letter-spacing: -.016em;
    font-weight: 440;
    text-shadow: 0 1px 14px rgba(0,0,0,.18);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 41px;
    padding: 0 19px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1;
    font-weight: 610;
    white-space: nowrap;
    transition: background .2s ease,color .2s ease,transform .2s ease;
  }
  .action:hover { transform: translateY(-2px); }
  .action-primary {
    color: #222722;
    background: #f9f9f7;
    border: 1px solid #f9f9f7;
  }
  .action-primary span { font-size: 20px; font-weight: 400; }
  .action-secondary {
    color: white;
    border: 1px solid rgba(255,255,255,.82);
    background: rgba(255,255,255,.03);
  }
  .action-secondary:hover { background: rgba(255,255,255,.17); }

  /* Franja inferior: un párrafo a la izquierda y tres indicadores a la derecha. */
  .hero-bottom {
    position: absolute;
    z-index: 1;
    left: var(--inset);
    right: var(--inset);
    bottom: 5.3%;
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
    align-items: end;
    gap: 32px;
    margin: 0;
    padding: 13px 0 0;
    border-top: 1px solid rgba(255,255,255,.17);
  }
  .bottom-intro {
    max-width: 485px;
    margin: 0 0 3px;
    color: #eceeeb;
    font-size: clamp(13px,1.18vw,16px);
    line-height: 1.45;
    letter-spacing: -.012em;
    font-weight: 430;
  }
  .hero-services {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 14px;
    align-items: end;
    text-align: center;
  }
  .hero-services div { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .hero-services strong {
    color: #fff;
    font-size: clamp(27px,2.7vw,36px);
    font-weight: 510;
    letter-spacing: -.045em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .hero-services span {
    color: #e8eae7;
    font-size: clamp(10px,1.06vw,13px);
    font-weight: 440;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Menú móvil real; la maqueta en escritorio permanece limpia. */
  .mobile-navigation[hidden] { display:none !important; }
  @media (max-width: 959px) {
    .home-hero { --inset: clamp(22px,5vw,52px); min-height:100svh; height:auto; display:flex; flex-direction:column; }
    .site-header { position:relative; top:auto; left:auto; right:auto; padding:25px var(--inset) 0; flex:0 0 auto; }
    .desktop-nav { display:none; }
    .mobile-menu-trigger {
      display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
      width:44px; height:44px;
      border:1px solid rgba(255,255,255,.77);
      border-radius:9px; background:rgba(20,24,22,.32);
      cursor:pointer; color:#fff;
    }
    .mobile-menu-trigger span { width:19px; height:2px; border-radius:3px; background:white; }
    .mobile-navigation:not([hidden]) {
      position:absolute;z-index:20;top:85px;left:var(--inset);right:var(--inset);
      display:grid;gap:5px;padding:12px;
      border-radius:14px;border:1px solid rgba(255,255,255,.28);
      background:rgba(20,27,22,.96);backdrop-filter:blur(14px);
      box-shadow:0 18px 50px #0006;
    }
    .mobile-navigation a,.mobile-navigation button {
      font:inherit;color:white;background:none;border:0;text-align:left;
      padding:12px;border-radius:9px;font-size:14px;font-weight:600;
      cursor:pointer;
    }
    .mobile-navigation a:hover,.mobile-navigation button:hover { background:#ffffff18; }
    .hero-content {
      position:relative;top:auto;left:auto;right:auto;
      margin:clamp(96px,15vh,145px) var(--inset) clamp(125px,17vh,170px);
      flex:1 0 auto;max-width:760px;
    }
    h1 {font-size:clamp(42px,6.1vw,60px);}
    .hero-bottom {
      position:relative;bottom:auto;left:auto;right:auto;
      margin:0 var(--inset) 28px;flex:0 0 auto;
      grid-template-columns:1fr;gap:25px;
    }
    .hero-services {max-width:690px;text-align:left;}
    .hero-services strong {font-size:clamp(26px,4vw,34px);}
    .hero-services span {font-size:12px;}
  }
  @media (min-width:960px) and (max-height:650px) {
    .site-header { top:clamp(18px,4.4vh,32px); }
    .hero-content { top:20.5%; }
    h1 { font-size:clamp(40px,min(5.1vw,9.5vh),62px); }
    .hero-content p { margin-top:12px; font-size:14px; }
    .hero-actions { margin-top:14px; }
    .hero-bottom {bottom:4%;padding-top:9px;}
  }
  @media (max-width:600px) {
    .home-hero { --inset:clamp(20px,5.5vw,28px); }
    .hero-photo img { object-position:58% center; }
    .hero-shade {
      background:linear-gradient(180deg,rgba(12,17,16,.38) 0%,rgba(10,13,12,.47) 44%,rgba(7,9,9,.89) 100%),
      linear-gradient(90deg,rgba(10,15,13,.32),rgba(10,15,13,.09));
    }
    .site-header { padding-top:22px; }
    .wordmark {font-size:22px;}
    .hero-content {margin-top:clamp(91px,13vh,125px);margin-bottom:clamp(78px,12vh,120px);}
    h1 {font-size:clamp(34px,9.2vw,49px);line-height:1.09;}
    .hero-content p {font-size:14px;line-height:1.5;margin-top:17px;}
    .desktop-break {display:none;}
    .hero-actions {gap:10px;margin-top:20px;}
    .action {min-height:44px;padding:0 15px;font-size:12px;gap:10px;border-radius:8px;}
    .hero-bottom {padding-top:17px;gap:22px;margin-bottom:25px;}
    .bottom-intro {font-size:13px;}
    .hero-services {gap:8px;}
    .hero-services strong {font-size:clamp(19px,5.9vw,30px);}
    .hero-services span {font-size:10px;white-space:normal;}
  }
  @media (max-width:350px) {
    .hero-content {margin-top:79px;margin-bottom:62px;}
    h1 {font-size:33px;}
    .hero-services strong {font-size:19px;}
  }
  /* Ventanas de escritorio extremadamente bajas: evitar solapamientos. */
  @media (min-width:960px) and (max-height:480px) {
    .hero-content {top:17%;}
    h1 {font-size:min(4.5vw,8.5vh);}
    .hero-content p {margin-top:8px;font-size:12px;}
    .hero-actions {margin-top:9px;}
    .hero-bottom {bottom:3%;}
  }

  .hero-dialog {
    width:min(710px,calc(100% - 30px));max-height:min(85svh,800px);
    padding:clamp(24px,4vw,45px);border:1px solid #dddddb;border-radius:18px;
    background:#f8f8f5;color:#212723;box-shadow:0 25px 100px #0006;
  }
  .hero-dialog::backdrop {background:rgba(7,12,10,.75);backdrop-filter:blur(6px);}
  .dialog-close {position:absolute;right:16px;top:13px;width:40px;height:40px;background:#eee;border:0;border-radius:50%;font-size:26px;cursor:pointer;color:#1a211e;}
  .dialog-overline {font-size:11px;font-weight:750;letter-spacing:.16em;color:#69736d;}
  .hero-dialog h2 {font-size:clamp(25px,4vw,40px);line-height:1.15;letter-spacing:-.045em;margin:10px 0 14px;}
  .hero-dialog>p:not(.dialog-overline) {line-height:1.65;color:#536059;}
  .dialog-services {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin:25px 0;}
  .dialog-services article {padding:15px;border:1px solid #dcded9;border-radius:12px;background:white;}
  .dialog-services h3 {font-size:15px;margin:0 0 8px;}
  .dialog-services p {font-size:13px;line-height:1.5;margin:0;color:#5e6861;}
  .dialog-contact {display:inline-flex;align-items:center;gap:17px;background:#202b25;color:white;border-radius:9px;padding:13px 19px;font-size:14px;font-weight:700;}
  @media(max-width:600px){.dialog-services {grid-template-columns:1fr;}}
  @media(prefers-reduced-motion:reduce){.action,.desktop-nav a,.desktop-nav button {transition:none;}}
</style>