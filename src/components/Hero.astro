    image: 'https://images.unsplash.com/photo-1567248986135-c1dc986b198d?auto=format&fit=crop&w=1900&q=82',
    cards: [
      { title: 'Rejas de hierro', subtitle: 'Ventanas, patios y viviendas', tag: 'A medida', image: 'https://images.pexels.com/photos/33398368/pexels-photo-33398368.jpeg?auto=compress&cs=tinysrgb&w=480' },
      { title: 'Forja y detalles', subtitle: 'Diseños clásicos y actuales', tag: 'Hierro y forja', image: 'https://images.pexels.com/photos/39972580/pexels-photo-39972580.jpeg?auto=compress&cs=tinysrgb&w=480' }
    ]
  },
  {
    label: 'Puertas',
