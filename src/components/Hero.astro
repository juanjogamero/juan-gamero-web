---
const phone = '+34675731867';
const instagram = 'https://www.instagram.com/carpinteriametalica.juangamero/';
const services = [
  { title: 'Rejas y forja', text: 'Rejas de hierro, trabajos de forja y soluciones a medida para viviendas.' },
  { title: 'Puertas metálicas', text: 'Puertas para patios, cocheras, parcelas, fincas y accesos de naves.' },
  { title: 'Tejados y cubiertas', text: 'Tejados de chapa, chapa imitación teja, porches y espacios cubiertos.' },
  { title: 'Barandas y pasamanos', text: 'Barandas de hierro para balcones, escaleras y terrazas.' },
  { title: 'Estructuras y cerramientos', text: 'Estructuras metálicas, cerramientos de naves y soluciones para el campo.' },
  { title: 'Soldadura y arreglos', text: 'Reparaciones, soldaduras y trabajos especiales de hierro.' },
  { title: 'Puertas automáticas', text: 'Instalación y motorización mediante colaboración con profesionales especializados.' }
];
---

<section class="home-hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-photo" aria-hidden="true">
    <img
      src="https://images.pexels.com/photos/25565675/pexels-photo-25565675.jpeg?auto=compress&cs=tinysrgb&w=2200"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <header class="site-header">
    <a class="wordmark" href="#inicio" aria-label="Juan Gamero, ir al inicio">Juan Gamero<span class="wordmark-dot">.</span></a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <button type="button" data-open-modal="services">SERVICIOS</button>
      <a href={instagram} target="_blank" rel="noopener noreferrer">TRABAJOS</a>
      <button type="button" data-open-modal="areas">DÓNDE TRABAJAMOS</button>
      <a href={"tel:" + phone}>CONTACTO</a>
    </nav>
    <button class="mobile-menu-trigger" id="nav-trigger" type="button" aria-controls="mobile-navigation" aria-expanded="false" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </header>

  <nav class="mobile-navigation" id="mobile-navigation" aria-label="Navegación móvil" hidden>
    <button type="button" data-open-modal="services">Servicios</button>
    <a href={instagram} target="_blank" rel="noopener noreferrer">Trabajos</a>
    <button type="button" data-open-modal="areas">Dónde trabajamos</button>
    <a href={"tel:" + phone}>Contacto</a>
  </nav>

  <div class="hero-content">
    <h1 id="hero-title">Carpintería metálica. <span>Hierro hecho para durar.</span></h1>
    <p>Rejas, puertas, barandas y cubiertas de hierro a medida.<br class="desktop-break" /> En Casariche y pueblos cercanos.</p>
    <div class="hero-actions">
      <a class="action action-primary" href={"tel:" + phone}>Pedir presupuesto <span aria-hidden="true">→</span></a>
      <a class="action action-secondary" href={instagram} target="_blank" rel="noopener noreferrer">Ver trabajos</a>
    </div>
  </div>

  <div class="hero-bottom">
    <p class="bottom-intro">De una reja para casa a una cubierta para tu nave. Trabajos de hierro, forja y soldadura adaptados a lo que necesitas.</p>
    <div class="hero-services" aria-label="Especialidades de carpintería metálica">
      <div><strong>Rejas</strong><span>Protección y diseño</span></div>
      <div><strong>Puertas</strong><span>Accesos a medida</span></div>
      <div><strong>Tejados</strong><span>Chapa y cubiertas</span></div>
    </div>
  </div>
</section>

<dialog class="hero-dialog" id="services-dialog" aria-labelledby="services-dialog-heading">
  <button type="button" class="dialog-close" data-close-dialog aria-label="Cerrar ventana">×</button>
  <p class="dialog-overline">QUÉ HACEMOS</p>
  <h2 id="services-dialog-heading">Trabajos de carpintería metálica</h2>
  <p>Juan Gamero realiza trabajos de hierro a medida para viviendas, fincas, naves y negocios. Si necesitas algo que no aparece aquí, puedes consultarlo igualmente.</p>
  <div class="dialog-services">
    {services.map(service => <article><h3>{service.title}</h3><p>{service.text}</p></article>)}
  </div>
  <a class="dialog-contact" href={"tel:" + phone}>Consultar mi trabajo <span aria-hidden="true">→</span></a>
</dialog>

<dialog class="hero-dialog" id="areas-dialog" aria-labelledby="areas-dialog-heading">
  <button type="button" class="dialog-close" data-close-dialog aria-label="Cerrar ventana">×</button>
  <p class="dialog-overline">CERCA DE TI</p>
  <h2 id="areas-dialog-heading">Carpintería metálica en Casariche y alrededores</h2>
  <p>El taller trabaja desde Casariche y atiende encargos en poblaciones próximas como Herrera, Estepa, Pedrera, La Roda de Andalucía, Puente Genil y Osuna. Consulta disponibilidad para tu localidad.</p>
  <a class="dialog-contact" href={"tel:" + phone}>Preguntar por mi localidad <span aria-hidden="true">→</span></a>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('#nav-trigger');
  const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation');
  function closeNavigation() {
    if (mobileNavigation) mobileNavigation.hidden = true;
    trigger?.setAttribute('aria-expanded', 'false');
    trigger?.setAttribute('aria-label', 'Abrir menú');
  }
  trigger?.addEventListener('click', () => {
    const expanded = trigger.getAttribute('aria-expanded') === 'true';
    if (mobileNavigation) mobileNavigation.hidden = expanded;
    trigger.setAttribute('aria-expanded', String(!expanded));
    trigger.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú');
  });
  document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach(button => {
    button.addEventListener('click', () => {
      closeNavigation();
      const id = button.dataset.openModal === 'areas' ? 'areas-dialog' : 'services-dialog';
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      if (dialog && !dialog.open) dialog.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.hero-dialog').forEach(dialog => {
    dialog.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
  });
  mobileNavigation?.querySelectorAll('a').forEach(link => link.addEventListener('click',closeNavigation));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeNavigation();
  });
</script>

<style>
  .home-hero {
    --side: clamp(26px,5.75vw,88px);
    position:relative;isolation:isolate;
    width:100%;height:100vh;height:100svh;
    min-height:0;overflow:hidden;
    background:#181d1b;color:#fff;
    display:flex;flex-direction:column;
    padding:0 var(--side);
  }
  .hero-photo,.hero-shade,.hero-photo img {
    position:absolute;inset:0;width:100%;height:100%;
  }
  .hero-photo{z-index:-2;overflow:hidden}
  .hero-photo img{object-fit:cover;object-position:center 54%;filter:saturate(.74) contrast(.97)}
  .hero-shade{
    z-index:-1;pointer-events:none;
    background:
      linear-gradient(180deg,rgba(10,15,15,.18) 0%,rgba(9,14,13,.1) 28%,rgba(11,14,14,.38) 65%,rgba(9,12,12,.77) 100%),
      linear-gradient(90deg,rgba(9,16,15,.55) 0%,rgba(11,16,16,.43) 43%,rgba(10,16,16,.12) 100%);
  }
  .site-header{
    position:relative;z-index:5;
    padding-top:clamp(25px,4.5vh,43px);
    display:flex;align-items:center;justify-content:space-between;gap:24px;
    flex:0 0 auto;
  }
  .wordmark {
    display:inline-flex;align-items:baseline;
    font-size:clamp(21px,2.1vw,26px);
    font-weight:550;line-height:1;letter-spacing:-.055em;white-space:nowrap;
    transition:opacity .22s;
  }
  .wordmark:hover{opacity:.78}
  .wordmark-dot{color:#e4e7e4}
  .desktop-nav{display:flex;align-items:center;gap:clamp(23px,2.7vw,44px)}
  .desktop-nav a,.desktop-nav button{
    padding:6px 0;margin:0;border:0;background:transparent;
    color:#f6f7f5;font-size:11px;line-height:1.2;
    font-weight:650;letter-spacing:.025em;white-space:nowrap;
    transition:opacity .22s;cursor:pointer;
  }
  .desktop-nav a:hover,.desktop-nav button:hover{opacity:.6}
  .mobile-menu-trigger,.mobile-navigation[hidden]{display:none}
  .hero-content{
    position:relative;z-index:1;
    margin-top:clamp(67px,15.5vh,140px);
    margin-bottom:auto;
    max-width:980px;
    flex:0 1 auto;
  }
  h1{
    margin:0;max-width:960px;
    font-size:clamp(46px,5.25vw,76px);
    line-height:1.09;
    letter-spacing:-.054em;font-weight:620;
    text-wrap:balance;
  }
  h1 span{display:block}
  .hero-content p{
    margin:18px 0 0;
    font-size:clamp(14px,1.27vw,18px);
    font-weight:450;
    letter-spacing:-.012em;
    line-height:1.43;
    max-width:670px;
    color:#f2f3f0;
  }
  .hero-actions{display:flex;align-items:center;gap:16px;margin-top:21px}
  .action{
    border-radius:10px;
    display:inline-flex;align-items:center;justify-content:center;
    gap:17px;min-height:42px;padding:0 20px;
    font-size:14px;font-weight:650;
    transition:background .2s ease,color .2s ease,transform .2s ease;
  }
  .action:hover{transform:translateY(-2px)}
  .action-primary{color:#202522;background:#f7f8f6;border:1px solid #f7f8f6}
  .action-primary:hover{background:#fff}
  .action-primary span{font-size:19px;font-weight:400}
  .action-secondary{border:1px solid #ffffffad;color:white;background:#ffffff05}
  .action-secondary:hover{background:#ffffff20}
  .hero-bottom{
    position:relative;z-index:1;
    border-top:1px solid #ffffff57;
    padding-top:19px;
    margin-bottom:clamp(27px,4.7vh,44px);
    display:grid;grid-template-columns:minmax(0,1fr) minmax(460px,.96fr);
    align-items:end;gap:30px;flex:0 0 auto;
  }
  .bottom-intro{
    max-width:470px;
    color:#edf0ec;
    font-size:clamp(14px,1.2vw,17px);
    line-height:1.5;
    letter-spacing:-.01em;
    margin:0 0 2px;
  }
  .hero-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;text-align:center}
  .hero-services div{display:flex;flex-direction:column;gap:5px;min-width:0}
  .hero-services strong{font-size:clamp(27px,2.65vw,38px);line-height:1.1;font-weight:520;letter-spacing:-.045em;white-space:nowrap}
  .hero-services span{font-size:clamp(11px,1vw,13px);line-height:1.4;color:#e3e7e2;font-weight:450}
  .hero-dialog{
    width:min(710px,calc(100% - 30px));max-height:min(85svh,800px);
    padding:clamp(24px,4vw,45px);
    border:1px solid #dddddb;border-radius:18px;
    background:#f8f8f5;color:#212723;
    box-shadow:0 25px 100px #0006;
  }
  .hero-dialog::backdrop{background:rgba(7,12,10,.75);backdrop-filter:blur(6px)}
  .dialog-close{
    position:absolute;right:16px;top:13px;
    width:40px;height:40px;background:#eee;border:0;border-radius:50%;
    font-size:26px;cursor:pointer;color:#1a211e;
  }
  .dialog-overline{font-size:11px;font-weight:750;letter-spacing:.16em;color:#69736d}
  .hero-dialog h2{font-size:clamp(25px,4vw,40px);line-height:1.15;letter-spacing:-.045em;margin:10px 0 14px}
  .hero-dialog>p:not(.dialog-overline){line-height:1.65;color:#536059}
  .dialog-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin:25px 0}
  .dialog-services article{padding:15px;border:1px solid #dcded9;border-radius:12px;background:white}
  .dialog-services h3{font-size:15px;margin:0 0 8px}
  .dialog-services p{font-size:13px;line-height:1.5;margin:0;color:#5e6861}
  .dialog-contact{display:inline-flex;align-items:center;gap:17px;background:#202b25;color:white;border-radius:9px;padding:13px 19px;font-size:14px;font-weight:700}
  @media(min-width:981px) and (max-height:730px){
    .site-header{padding-top:clamp(23px,4vh,35px)}
    .hero-content{margin-top:clamp(65px,14vh,110px)}
    h1{font-size:clamp(43px,min(5.1vw,9vh),68px)}
    .hero-bottom{margin-bottom:clamp(23px,3.9vh,34px);padding-top:16px}
  }
  @media(min-width:981px) and (max-height:590px){
    .hero-content{margin-top:35px}
    h1{font-size:clamp(39px,5vw,56px)}
    .hero-content p{margin-top:12px;font-size:14px}
    .hero-actions{margin-top:14px}
    .hero-bottom{margin-bottom:18px}
  }
  @media(max-width:980px){
    .home-hero{--side:clamp(22px,5vw,55px)}
    .desktop-nav{display:none}
    .mobile-menu-trigger{
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;
      width:44px;height:44px;border:1px solid #ffffff8a;
      border-radius:9px;background:rgba(17,23,19,.22);color:white;cursor:pointer;
    }
    .mobile-menu-trigger span{width:19px;height:2px;background:white;border-radius:4px}
    .mobile-navigation:not([hidden]){
      position:absolute;z-index:6;left:var(--side);right:var(--side);top:85px;
      display:grid;gap:5px;padding:13px;
      background:rgba(22,28,24,.94);backdrop-filter:blur(16px);
      border:1px solid #fff4;border-radius:13px;box-shadow:0 20px 45px #0005;
    }
    .mobile-navigation a,.mobile-navigation button{
      color:white;border:0;background:none;padding:12px;
      text-align:left;text-decoration:none;font-size:14px;font-weight:600;border-radius:8px;
    }
    .mobile-navigation a:hover,.mobile-navigation button:hover{background:#ffffff15}
    .hero-content{margin-top:clamp(95px,15vh,150px)}
    h1{font-size:clamp(40px,5.9vw,65px)}
    .hero-bottom{grid-template-columns:1fr;gap:27px;align-items:start}
    .hero-services{text-align:left;max-width:660px}
  }
  @media(max-width:600px){
    .home-hero{
      min-height:100svh;height:auto;
      padding:0 var(--side);
    }
    .site-header{padding-top:23px}
    .wordmark{font-size:22px}
    .hero-photo img{object-position:58% center}
    .hero-shade{background:linear-gradient(180deg,rgba(12,17,16,.42) 0%,rgba(10,13,12,.58) 46%,rgba(7,9,9,.9) 100%),linear-gradient(90deg,rgba(10,15,13,.35),rgba(10,15,13,.1))}
    .hero-content{
      margin-top:clamp(86px,13vh,125px);
      margin-bottom:clamp(73px,13vh,130px);
      max-width:500px;
      flex:1 0 auto;
    }
    h1{font-size:clamp(34px,9.3vw,50px);line-height:1.095;letter-spacing:-.056em}
    h1 span{margin-top:3px}
    .hero-content p{font-size:14px;line-height:1.5;margin-top:19px}
    .desktop-break{display:none}
    .hero-actions{gap:10px;flex-wrap:wrap;margin-top:22px}
    .action{min-height:44px;font-size:12px;padding:0 15px;border-radius:8px;gap:10px}
    .hero-bottom{padding-top:19px;gap:23px;margin-bottom:27px}
    .bottom-intro{font-size:13px;max-width:460px}
    .hero-services{gap:9px}
    .hero-services strong{font-size:clamp(19px,5.8vw,29px)}
    .hero-services span{font-size:10px}
    .dialog-services{grid-template-columns:1fr}
  }
  @media(max-width:360px){
    .hero-content{margin-top:80px;margin-bottom:65px}
    h1{font-size:34px}
    .action{font-size:11px}
    .hero-services strong{font-size:20px}
    .hero-services span{font-size:9px}
  }
  @media(prefers-reduced-motion:reduce){
    .wordmark,.desktop-nav a,.desktop-nav button,.action{transition:none}
  }
</style>