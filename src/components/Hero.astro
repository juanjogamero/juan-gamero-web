    detail: 'Fabricación y montaje',
    image: 'https://images.pexels.com/photos/39743614/pexels-photo-39743614.jpeg?auto=compress&cs=tinysrgb&w=1900',
    cards: [
      { title: 'Puertas metálicas', subtitle: 'Patios, cocheras y entradas', tag: 'A medida', image: 'https://images.pexels.com/photos/14355575/pexels-photo-14355575.jpeg?auto=compress&cs=tinysrgb&w=480' },
      { title: 'Puertas de campo', subtitle: 'Parcelas, fincas y naves', tag: 'Uso diario', image: 'https://images.pexels.com/photos/13278911/pexels-photo-13278911.jpeg?auto=compress&cs=tinysrgb&w=480' }
    ]
  },
  {
