---
const cards = [
  { title:'Rejas y puertas', subtitle:'de hierro' },
  { title:'Forja y trabajos', subtitle:'a medida' },
  { title:'Estructuras', subtitle:'metálicas' },
  { title:'Soluciones para', subtitle:'cada proyecto' },
  { title:'Presupuesto', subtitle:'sin compromiso' }
];
---
<section class="features-strip" id="servicios" aria-label="Trabajos y ventajas de Juan Gamero">
  <div class="features-grid">
    <article class="feature-card">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 22 18-16 18 16"/><path d="M11 18v23h26V18M21 41V29h8v12"/></svg>
      <h2>Rejas y puertas<br />de hierro</h2>
    </article>
    <article class="feature-card">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M42 5C22 6 10 16 9 29c-1 7 6 12 13 9C35 32 39 17 42 5Z"/><path d="M6 43c8-13 18-22 31-31M16 33l-1-11m10 3 10-1"/></svg>
      <h2>Forja y trabajos<br />a medida</h2>
    </article>
    <article class="feature-card">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m24 3 11 6v13l-11 6-11-6V9l11-6Z"/><path d="m13 9 11 7 11-7M24 16v12"/><path d="M13 22 3 28v12l10 5 10-5V28l-10-6ZM3 28l10 6 10-6M13 34v11"/><path d="m35 22-10 6v12l10 5 10-5V28l-10-6ZM25 28l10 6 10-6M35 34v11"/></svg>
      <h2>Estructuras<br />metálicas</h2>
    </article>
    <article class="feature-card">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M34 28v15H5V11h22"/><path d="M13 34h13M13 27h7"/><path d="m19 21 19-19 7 7-19 19-9 2 2-9Z"/><path d="m33 7 7 7"/></svg>
      <h2>Soluciones para<br />cada proyecto</h2>
    </article>
    <article class="feature-card">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3h19l9 9v32H10V3ZM29 3v10h9M16 23h16M16 30h16M16 37h12"/></svg>
      <h2>Presupuesto<br />sin compromiso</h2>
    </article>
  </div>
</section>
<style>
  .features-strip {
    background:#fbfbfa;
    padding:clamp(38px,4.1vw,70px) clamp(20px,6vw,115px);
    min-height:210px;
    scroll-margin-top:78px;
  }
  .features-grid {
    width:100%;max-width:1500px;margin-inline:auto;
    display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;
  }
  .feature-card{
    display:flex;align-items:center;justify-content:flex-start;gap:clamp(10px,1.3vw,19px);
    min-width:0;min-height:125px;
    background:#f6f6f5;
    border:1px solid #f1f1ef;
    border-radius:5px;
    padding:19px clamp(11px,1.3vw,24px);
    box-shadow:0 5px 20px rgba(23,31,26,.022);
    transition:transform .22s ease,background .22s ease;
  }
  .feature-card:hover{transform:translateY(-3px);background:#f2f3f0}
  .feature-card svg{flex:none;width:clamp(31px,3.1vw,49px);height:clamp(31px,3.1vw,49px);color:#84948d}
  .feature-card h2{font-family:inherit;font-size:clamp(12px,1.06vw,15px);line-height:1.38;letter-spacing:-.025em;font-weight:700;margin:0;color:#2a3530}
  @media(max-width:1050px){
    .features-strip{padding:34px 25px}
    .features-grid{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:3px 2px 12px;scrollbar-width:thin}
    .feature-card{flex:0 0 230px;scroll-snap-align:start}
    .feature-card svg{width:40px;height:40px}
    .feature-card h2{font-size:14px}
  }
  @media(max-width:600px){
    .features-strip{padding:27px 16px;min-height:0}
    .feature-card{min-height:110px;flex-basis:220px;padding:17px 15px}
  }
  @media(prefers-reduced-motion:reduce){.feature-card{transition:none}}
</style>